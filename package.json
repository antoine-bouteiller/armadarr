{
  "name": "armadarr",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint --fix --fix-suggestions --max-warnings=0",
    "dev": "bun --watch src/index.ts",
    "knip": "devkit knip",
    "knip:production": "devkit knip --production",
    "test": "bun test ./tests",
    "test:watch": "bun test ./tests --watch",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "postinstall": "bun scripts/nix_deps.ts"
  },
  "packageManager": "bun@1.4.5",
  "dependencies": {
    "@effect/platform-bun": "4.1.5",
    "effect": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@antoine-bouteiller/devkit": "0.5.1",
    "@effect/tsgo": "0.73.4",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0"
  }
}
